PORT=
MONGODB_URI=
# Danh sách origin của frontend, cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:3000
# Số tầng reverse proxy trước backend (vd: 1 khi có nginx). Để trống khi chạy trực tiếp
TRUST_PROXY=

#Config JWT
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRED=
JWT_REFRESH_TOKEN_EXPIRE=

#Config Mail
MAIL_USER=
MAIL_KEY=
MAIL_HOST=
MAIL_PORT=

# Config VNPay sandbox
VNPAY_PAYMENT_URL=
VNPAY_API_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_IP_ADDR=

# Cloudinary: lưu trữ ảnh sản phẩm
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push. Tạo khoá bằng: npx web-push generate-vapid-keys
# Bỏ trống thì Web Push tắt, thông báo realtime trong trang vẫn hoạt động
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: hoặc URL liên hệ của chủ cửa hàng, dịch vụ push dùng khi cần báo lỗi
VAPID_SUBJECT=mailto:admin@example.com
